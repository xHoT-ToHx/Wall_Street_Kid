{
  "name": "Wall Street Kid",
  "version": "0.1.0",
  "platform": "fc",
  "source_lang": "en",
  "rom": "rom/Wall Street Kid (USA).nes",
  "rom_sha1": "caba8f34159eba1ecff38dd7097218c63c240ad7",
  "rom_crc32": "e256aed4",
  "tables": {
    "ja": [
      "tables/ja.tbl"
    ],
    "ko": [
      "tables/ko_ctrl.tbl",
      "tables/ko_font.tbl"
    ]
  },
  "spec": "spec.json",
  "scripts_dir": "scripts",
  "inserts": [],
  "commands": [
    [
      "python",
      "asm/tools/expand.py",
      "{rom}",
      "--copy",
      "4:12",
      "--copy",
      "6:13"
    ],
    [
      "python",
      "asm/tools/kor_build.py",
      "tables"
    ],
    [
      "python",
      "asm/tools/kor_build.py",
      "font",
      "{rom}"
    ],
    [
      "python",
      "asm/tools/kor_build.py",
      "text",
      "{rom}",
      "--report",
      "build/kor_text_report.txt"
    ],
    [
      "python",
      "asm/tools/kor_build.py",
      "ui",
      "{rom}",
      "--report",
      "build/kor_ui_report.txt"
    ],
    [
      "python",
      "asm/tools/kor_build.py",
      "title",
      "{rom}"
    ],
    [
      "python",
      "asm/tools/asm65.py",
      "asm/kor_engine.asm",
      "{rom}",
      "--sym",
      "build/kor_engine.sym"
    ]
  ],
  "output": "build/Wall_Street_Kid_kr.nes",
  "patch": {
    "format": "bps",
    "out": "release/Wall_Street_Kid_kr_v{version}.bps"
  },
  "insert_scripts": false
}
